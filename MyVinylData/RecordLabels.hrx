        </xs:choice>
      </xs:complexType>
      <xs:unique name="Constraint1">
        <xs:selector xpath=".//RecordLabels" />
        <xs:field xpath="LabelId" />
      </xs:unique>
    </xs:element>
  </xs:schema>
