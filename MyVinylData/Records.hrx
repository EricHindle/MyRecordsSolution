<?xml version="1.0" standalone="yes"?>
<NewDataSet>
  <xs:schema id="NewDataSet" xmlns="" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
    <xs:element name="NewDataSet" msdata:IsDataSet="true" msdata:MainDataTable="Records" msdata:UseCurrentLocale="true">
      <xs:complexType>
        <xs:choice minOccurs="0" maxOccurs="unbounded">
          <xs:element name="Records">
            <xs:complexType>
              <xs:sequence>
                <xs:element name="RecordId" msdata:AutoIncrement="true" msdata:AutoIncrementSeed="1" type="xs:int" />
                <xs:element name="Format" default="''">
                  <xs:simpleType>
                    <xs:restriction base="xs:string">
                      <xs:maxLength value="3" />
                    </xs:restriction>
                  </xs:simpleType>
                </xs:element>
                <xs:element name="Label" type="xs:int" default="-1" />
                <xs:element name="Size" type="xs:int" default="-1" />
                <xs:element name="Speed" default="''">
                  <xs:simpleType>
                    <xs:restriction base="xs:string">
                      <xs:maxLength value="3" />
                    </xs:restriction>
                  </xs:simpleType>
                </xs:element>
                <xs:element name="Copies" type="xs:int" default="-1" />
                <xs:element name="RecordNo" default="''">
                  <xs:simpleType>
                    <xs:restriction base="xs:string">
                      <xs:maxLength value="20" />
                    </xs:restriction>
                  </xs:simpleType>
                </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
        </xs:choice>
      </xs:complexType>
      <xs:unique name="Constraint1">
        <xs:selector xpath=".//Records" />
        <xs:field xpath="RecordId" />
      </xs:unique>
    </xs:element>
  </xs:schema>
</NewDataSet>